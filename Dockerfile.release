ARG RUST_IMAGE=rust:1.94.1-bookworm
FROM ${RUST_IMAGE}

ARG STELLAR_CLI_VERSION=27.0.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        jq \
        libdbus-1-dev \
        libssl-dev \
        libudev-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN cargo install --locked stellar-cli --version ${STELLAR_CLI_VERSION} --root /usr/local/cargo-bin

ENV PATH="/usr/local/cargo-bin/bin:${PATH}"
ENV CARGO_TERM_COLOR=never

WORKDIR /workspace
